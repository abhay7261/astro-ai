PORT=5000
NODE_ENV=development
ADMIN_MASTER_PIN=7788
JWT_SECRET=your_jwt_secret_here

# MongoDB Connection String (Atlas Cloud or Local)
# Example Atlas: mongodb+srv://username:password@cluster0.xxxx.mongodb.net/astroai?retryWrites=true&w=majority
# Example Local: mongodb://127.0.0.1:27017/astroai
MONGODB_URI=mongodb://127.0.0.1:27017/astroai

# Google Gemini AI API Key (Free tier from aistudio.google.com)
GEMINI_API_KEY=

# Cloudinary Media Storage (Free 25GB from cloudinary.com for video reels)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
